META_GRAPH_VERSION=vXX.X
META_PAGES_JSON='[{"id":"1234567890","name":"Example Page","url":"https://www.facebook.com/example.page","access_token":"replace-with-page-access-token"}]'

REACTION_TYPES=ANGRY,HAHA
MONITOR_COMMENTS=true
MONITOR_RATINGS=true
REVIEW_KEYWORDS='نصاب,نصابين,لا انصح,حرامي,حرامية,نصب'
POLL_INTERVAL_SECONDS=30
GRAPH_TIMEOUT_SECONDS=20
MAX_EDGE_PAGES=10
MAX_GRAPH_REQUESTS_PER_CYCLE=500
MAX_REACTION_BROWSER_PAGES_PER_CYCLE=100
MAX_REACTION_ACTORS_PER_OBJECT=500
MAX_MODERATION_ACTIONS_PER_RUN=25

DEFENSE_STATE_PATH=.runtime/reaction-defense-state.json
DEFENSE_LOG_PATH=.runtime/reaction-defense.log

BROWSER_STORAGE_STATE=.runtime/facebook-storage.json
BROWSER_HEADLESS=true
FACEBOOK_REACTION_LABELS_JSON='{"ANGRY":"Angry","HAHA":"Haha"}'
FACEBOOK_REACTION_ICON_SRC_MARKERS_JSON='{"ANGRY":"replace-with-angry-icon-marker","HAHA":"replace-with-haha-icon-marker"}'
